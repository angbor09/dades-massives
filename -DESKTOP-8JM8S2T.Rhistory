# Contar declaraciones por año
datos_anuales <- dades %>%
count(date_inscribed, name = "declaraciones")
# Contar declaraciones por año
datos <- table(dades$date_inscribed)
datos <- as.data.frame(datos)
View(datos)
# Crear el gráfico
ggplot(datos, aes(x = Var1, y = Freq)) +
geom_line(color = "steelblue", linewidth = 1) +
geom_point(color = "steelblue", size = 1.5) +
labs(
title = "Evolución de las declaraciones de Patrimonio Mundial",
x = "Año de declaración",
y = "Número de declaraciones"
) +
theme_minimal()
