centre <- aggregate(cbind(long, lat) ~ region, data = us_states, FUN = mean)
View(centre)
centre$inicials <- toupper(substr(centre$region, 1, 2))
head(centre)
mapa.USA <- mapa.USA +
geom_text(data = centre, aes(x = long, y = lat, label = inicials), size = 3)
mapa.USA
