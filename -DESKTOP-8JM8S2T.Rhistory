library(mapSpain) # carreguem el paquet
library(sf)
library(scales)
ccaa_map <- mapSpain::esp_get_ccaa()
View(ccaa_map)
ggplot(ccaa_map) +
geom_sf()
ggplot(ccaa_map) +
geom_sf(fill = "lightblue", color = "white")
poblacion <- read.csv("data/2915.csv",
fileEncoding = "latin1",
header = T,
sep = "\t",
colClasses = c(Codigo = "character"))
View(poblacion)
View(poblacion)
ccaa_map_pob <- ccaa_map %>%
left_join(poblacion, by = c("codauto" = "Codigo"))
View(ccaa_map_pob)
ggplot(ccaa_map_pob) +
geom_sf(aes(fill = Poblacion), color = "white") +
scale_fill_gradient(
name = "Població",
low = "#dceefb",
high = "#0747a6",
labels = label_comma(big.mark = ".")) +
labs(title = "Població per Comunitats Autònomes",
caption = "Font: Instituto Nacional de Estadística")
