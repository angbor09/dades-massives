ciutats <- read.table("data/ciutats.txt",
fileEncoding = "UTF-8",
header = TRUE,
sep = "\t")
head(ciutats, 20)
ggplot(data = ciutats) +
borders("world", c("spain", "portugal")) +
aes(x = lon, y = lat) +
geom_point()
ggplot() + borders("world", fill = "white") +
geom_point(data = ciutats, aes(x = lon, y = lat)) +
geom_text(data = ciutats, aes(x = lon, y = lat, label = ciutat)) +
coord_fixed (xlim= c(-10,10),
ylim= c(35,45),
ratio = 1.2)
ggplot() + borders("world", fill = "blue") +
geom_point(data = ciutats, aes(x = lon, y = lat)) +
geom_text(data = ciutats, aes(x = lon, y = lat, label = ciutat)) +
coord_fixed (xlim= c(-10,10),
ylim= c(35,45),
ratio = 1.2)
